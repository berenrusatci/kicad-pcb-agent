{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projecte.local/schemas/pair-coupling-report/v1",
  "title": "ProjectE differential-pair coupling screen",
  "description": "Output of scripts/board/pair_coupling.py, vendored from krt12_out/coupling.py. A SCREEN, not a sign-off: sampled same-layer centreline proximity, no impedance and no FEXT/NEXT model.",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "board",
    "design",
    "params",
    "metrics",
    "by_check",
    "checks",
    "summary",
    "model_class",
    "signoff",
    "pairs",
    "coverage",
    "status",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": "pair-coupling-report/v1"
    },
    "tool": {
      "const": "pair_coupling.py"
    },
    "board": {
      "type": "string",
      "minLength": 1
    },
    "model_class": {
      "const": "sampled_centreline_proximity_screen"
    },
    "signoff": {
      "const": false
    },
    "params": {
      "type": "object",
      "required": [
        "spacing_max_mm",
        "coupled_threshold",
        "step_mm"
      ],
      "properties": {
        "spacing_max_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "coupled_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "step_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pair",
          "p_total_mm",
          "n_total_mm",
          "coupled_fraction",
          "measurable",
          "coupled"
        ],
        "properties": {
          "pair": {
            "type": "string",
            "minLength": 1
          },
          "coupled_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "measurable": {
            "type": "boolean"
          },
          "coupled": {
            "type": "boolean"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "eligible",
        "scanned",
        "excluded",
        "violations",
        "reason"
      ],
      "properties": {
        "eligible": {
          "type": "integer",
          "minimum": 0
        },
        "scanned": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        },
        "violations": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1
    },
    "summary": {
      "type": "object",
      "required": [
        "PASS",
        "FAIL",
        "NO_COVERAGE"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "NO_COVERAGE"
      ]
    },
    "limits": {
      "type": "string",
      "minLength": 1
    },
    "design": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "description": "The board this report measured, with its digest. REQUIRED: an untieable report is SCREEN_ONLY however good the number in it is. sha256 is null when the path could not be read - loud, not absent.",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "metrics": {
      "type": "object",
      "description": "check name -> violation count. Exists because `checks` is a list and the assertion selector grammar addresses a.b paths. A count of 0 is NOT a pass when scanned == 0; that distinction lives in `checks`.",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "by_check": {
      "type": "object",
      "description": "check name -> {status, scanned, violations}. The name-keyed map that carries COVERAGE, which `metrics` cannot. These are the two halves of one fix and they point in opposite directions: `metrics` is null for an unmeasured check so a threshold comparison CANNOT falsely succeed, and `by_check` lets a rule affirmatively assert that the check ran - `by_check.X.status equals PASS` means ran + examined something + clean, because Finding refuses to build a scanned==0 PASS. Null alone turns a vacuous PASS into a type error, which reads as a broken rule rather than an empty check; by_check alone would leave existing metrics.* bindings comparing 0 to 0. NOTE the denominator is only as honest as the producer: `scanned` must be the population the check actually examined, not a larger set that happens to be non-empty.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "scanned",
          "violations"
        ],
        "properties": {
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NO_COVERAGE"
            ]
          },
          "scanned": {
            "type": "integer",
            "minimum": 0
          },
          "violations": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$comment": "Zero eligible pairs is NO_COVERAGE. The vendored original printed 'COUPLED 0/0' and exited 0, which read as a pass for a board nobody measured."
}
