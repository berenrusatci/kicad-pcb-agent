{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projecte.local/schemas/connector-current-report/v1",
  "title": "ProjectE connector current cross-check report",
  "description": "Output of tools/scripts/connector_current.py. Serves the matrix row 'Konnektör akımı (derating sonrası)'. CAPACITY comes from connector_spec.json, DEMAND comes from rail_tree.json, and the rail -> contact-group mapping is an input. connector_spec's own current.rail_cross_check block is never read as demand; where it declares one it is compared against the rail tree and a disagreement is a FAIL. 'signoff' is pinned false: this compares two documents and measures no contact.",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "status",
    "effective_status",
    "reason_codes",
    "phase",
    "signoff",
    "inputs",
    "independence",
    "params",
    "links",
    "excluded_rails",
    "rail_coverage",
    "rail_coverage_violations",
    "connector_coverage_violations",
    "findings",
    "coverage",
    "limits"
  ],
  "properties": {
    "schema_version": {"const": "connector-current-report/v1"},
    "tool": {"const": "connector_current"},
    "status": {"enum": ["GREEN", "RED", "NO_COVERAGE"]},
    "effective_status": {"enum": ["GREEN", "RED", "NO_COVERAGE", "ERROR"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "phase": {"const": "early_schematic"},
    "signoff": {
      "const": false,
      "$comment": "Contact current sharing is an electro-thermal measurement (matrix C->D). Nothing here promotes it."
    },
    "inputs": {
      "type": "object",
      "required": ["connector_spec", "rail_tree", "map"],
      "properties": {
        "connector_spec": {"$ref": "#/$defs/artifact"},
        "rail_tree": {"$ref": "#/$defs/artifact"},
        "map": {"$ref": "#/$defs/artifact"}
      },
      "additionalProperties": false,
      "$comment": "Both sides are hash-bound. A verdict that cannot name the bytes it read is not reproducible."
    },
    "independence": {
      "type": "object",
      "required": ["capacity_from", "demand_from", "note"],
      "properties": {
        "capacity_from": {"const": "connector_spec.connectors[].current"},
        "demand_from": {"const": "rail_tree.rails[].i_max_a"},
        "note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "params": {
      "type": "object",
      "required": ["min_margin_a"],
      "properties": {
        "min_margin_a": {
          "type": ["number", "null"],
          "$comment": "null means no margin was asked for and only the SIGN of capacity - demand was judged. There is no default margin: a required headroom is an engineering decision, not a tool constant."
        }
      },
      "additionalProperties": false
    },
    "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
    "excluded_rails": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rail", "reason"],
        "properties": {
          "rail": {"type": "string"},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "rail_coverage": {
      "type": "object",
      "required": ["eligible", "scanned", "excluded", "violations"],
      "properties": {
        "eligible": {"type": "integer", "minimum": 0},
        "scanned": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0},
        "violations": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false,
      "$comment": "A metric_coverage triple over the rails in the rail tree: scanned + excluded == eligible, checked with common.findings.coverage_rule_violations before the report is emitted."
    },
    "rail_coverage_violations": {"type": "array", "items": {"type": "object"}},
    "connector_coverage_violations": {"type": "array", "items": {"type": "object"}},
    "findings": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["check", "status", "scanned", "violations", "detail"],
        "properties": {
          "check": {
            "enum": [
              "mapping_accounts_for_every_rail",
              "mapping_accounts_for_every_power_connector",
              "connector_capacity_is_derated_and_sourced",
              "rail_demand_is_present_and_sourced",
              "demand_within_connector_capacity",
              "connector_spec_declared_cross_check_agrees"
            ]
          },
          "status": {"enum": ["PASS", "FAIL", "NO_COVERAGE"]},
          "scanned": {"type": "integer", "minimum": 0},
          "violations": {"type": "array"},
          "detail": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "required": ["PASS", "FAIL", "NO_COVERAGE"],
      "properties": {
        "PASS": {"type": "integer", "minimum": 0},
        "FAIL": {"type": "integer", "minimum": 0},
        "NO_COVERAGE": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "limits": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": [
        "rail",
        "refdes",
        "contact_group",
        "contact_count",
        "status",
        "reason_codes",
        "capacity_a",
        "demand_a",
        "margin_a",
        "spec_declared_demand_a",
        "detail",
        "provenance"
      ],
      "properties": {
        "rail": {"type": "string", "minLength": 1},
        "refdes": {"type": "string", "minLength": 1},
        "contact_group": {"type": "string", "minLength": 1},
        "contact_count": {"type": "integer", "minimum": 1},
        "status": {"enum": ["PASS", "FAIL", "NO_COVERAGE"]},
        "reason_codes": {"type": "array", "items": {"type": "string"}},
        "capacity_a": {
          "type": ["number", "null"],
          "$comment": "null whenever the capacity would have to be guessed. The room-temperature rating is never substituted here: it is the optimistic number, not a conservative stand-in."
        },
        "demand_a": {"type": ["number", "null"]},
        "margin_a": {"type": ["number", "null"]},
        "spec_declared_demand_a": {
          "type": ["number", "null"],
          "$comment": "What connector_spec's own rail_cross_check claimed, recorded so the reader can see it was CHECKED rather than used."
        },
        "detail": {"type": "string"},
        "provenance": {
          "type": "object",
          "required": ["capacity", "demand"],
          "properties": {
            "capacity": {"type": "object"},
            "demand": {"type": "object"}
          },
          "additionalProperties": false,
          "$comment": "Carries which document each number came from, so a reader never has to trust the report's arithmetic without being able to re-read its inputs."
        }
      },
      "additionalProperties": false
    }
  }
}
