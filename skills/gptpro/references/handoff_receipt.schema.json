{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gptpro/handoff_receipt.schema.json",
  "title": "GPTPro handoff_receipt.json",
  "$comment": "Published OUTSIDE the zips, next to them, because a zip cannot self-consistently contain its own SHA-256 — the receipt is written after the archives exist. Its consumer is the producer/checker, not the external model.",
  "type": "object",
  "required": [
    "schema_version", "snapshot_id", "authority", "snapshot", "bundles",
    "aggregate_coverage_files", "aggregate_coverage_bytes", "exclusion_inventory",
    "missing_sources", "credential_scan", "content_policy", "disclosure_gate",
    "maker_id", "checker_id", "independence", "verdict", "verdict_reasons",
    "upload_authorized", "verdict_scope"
  ],
  "properties": {
    "schema_version": {"const": "gptpro-handoff/v1"},
    "generator": {"type": "string"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "project_root": {"type": "string"},
    "output_dir": {"type": "string"},
    "bundle_prefix": {"type": "string"},
    "bundles_conf": {"type": ["string", "null"]},
    "bundles_conf_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "export_tool_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "export_tool_files": {"type": "array"},
    "config_mode": {"enum": ["explicit", "autodetect"]},
    "export_started_utc": {"type": "string"},
    "export_finished_utc": {"type": "string"},
    "authority": {
      "type": "object",
      "required": ["asserts", "does_not_assert"],
      "properties": {
        "asserts": {"const": "this snapshot carries the declared scope at these hashes"},
        "does_not_assert": {"type": "array", "items": {"type": "string"}}
      }
    },
    "snapshot": {
      "type": "object",
      "required": ["vcs", "repo_commit", "dirty"],
      "properties": {
        "vcs": {"type": ["string", "null"]},
        "repo_commit": {"type": ["string", "null"]},
        "branch": {"type": ["string", "null"]},
        "dirty": {"type": ["boolean", "null"]},
        "dirty_inventory_sha256": {"type": ["string", "null"]},
        "tracked_modified": {"type": ["integer", "null"]},
        "untracked": {"type": ["integer", "null"]},
        "note": {"type": ["string", "null"]}
      }
    },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "zip_name", "zip_bytes", "zip_sha256", "manifest_sha256"],
        "properties": {
          "name": {"type": "string"},
          "purpose": {"type": "string"},
          "zip_name": {"type": "string"},
          "zip_bytes": {"type": "integer", "minimum": 0},
          "zip_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "files": {"type": "integer", "minimum": 0},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "aggregate_coverage_files": {"$ref": "#/$defs/coverage"},
    "aggregate_coverage_bytes": {"$ref": "#/$defs/coverage"},
    "exclusion_inventory": {"type": "array"},
    "missing_sources": {
      "type": "array",
      "$comment": "Always empty in a published receipt: a missing required source aborts the export with NO_COVERAGE and nothing is published. The field exists so 'none missing' and 'never checked' are distinguishable."
    },
    "optional_sources_absent": {"type": "array"},
    "credential_scan": {
      "type": "object",
      "required": ["scope", "asserts", "does_not_assert", "coverage_files", "hard_hits"],
      "$comment": "Reported under its own scope name. The old tool logged 'secret scan clean' and let the reader hear 'safe to upload'; those are different claims and only one of them was measured.",
      "properties": {
        "scope": {"const": "credential_scan"},
        "asserts": {"type": "string"},
        "does_not_assert": {"type": "string"},
        "coverage_files": {"$ref": "#/$defs/coverage"},
        "hard_hits": {"type": "array"},
        "soft_hit_count": {"type": "integer", "minimum": 0},
        "allow_secrets_override": {"type": "boolean"}
      }
    },
    "content_policy": {
      "type": "object",
      "required": ["scope", "coverage_files", "violations"],
      "$comment": "Applied to the STAGED tree, so a `file:` declaration cannot buy a restricted file past a policy that a `dir:` declaration would have enforced. Inclusion mechanism is not a policy.",
      "properties": {
        "scope": {"const": "content_policy"},
        "asserts": {"type": "string"},
        "coverage_files": {"$ref": "#/$defs/coverage"},
        "violations": {"type": "array"}
      }
    },
    "disclosure_gate": {
      "type": "object",
      "required": ["status", "upload_authorized", "authority", "coverage_files", "reason"],
      "$comment": "Spec open question K-1: this repo has no canonical third-party sharing authority for vendor-derived material. With no policy record at all the status is CONFIRM and upload is unauthorized. There is deliberately no override flag — one would rebuild the laundering path this gate exists to close.",
      "properties": {
        "status": {"enum": ["GREEN", "RED", "CONFIRM"]},
        "upload_authorized": {"type": "boolean"},
        "authority": {"type": ["string", "null"]},
        "policy_path": {"type": ["string", "null"]},
        "policy_sha256": {"type": ["string", "null"]},
        "decided_utc": {"type": ["string", "null"]},
        "coverage_files": {"$ref": "#/$defs/coverage"},
        "allowed": {
          "type": "integer", "minimum": 0,
          "$comment": "Staged files a rule cleared for disclosure."
        },
        "confirm_required": {
          "type": "integer", "minimum": 0,
          "$comment": "Staged files a rule classified as 'authority undefined'. NOT the same as unclassified: somebody looked at this class and recorded that nobody has the standing to clear it. Both land on CONFIRM; they are counted separately because 'we know we don't know' and 'we didn't look' must not share a number."
        },
        "confirm_classes": {"type": "array", "items": {"type": "string"}},
        "confirm_sample": {"type": "array", "items": {"type": "string"}},
        "unclassified": {
          "type": "integer", "minimum": 0,
          "$comment": "Staged files matching no rule at all — UNKNOWN. There is no catch-all allow rule by design, so a file added to the repo later lands here rather than becoming silently shareable."
        },
        "unclassified_sample": {"type": "array", "items": {"type": "string"}},
        "denied": {"type": "array"},
        "reason": {"type": "string"}
      }
    },
    "maker_id": {"type": ["string", "null"]},
    "checker_id": {"type": ["string", "null"]},
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["separate_session", "note"],
      "$comment": "Reuses the semantic already defined by skills/design-checker/references/checker_report.schema.json rather than inventing a second one. If the same context produced and checked the handoff, shared-assumption error is unmeasurable and must be stated, not implied away.",
      "properties": {
        "separate_session": {"type": "boolean"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "external_report_acceptance": {
      "enum": ["CONFIRM", "eligible_for_claim_audit"],
      "$comment": "Never a verdict on a finding. `eligible_for_claim_audit` means only that the maker/checker split is recorded as separate; claim-audit still owns DOĞRU/YANLIŞ/DOĞRULANAMAZ."
    },
    "verdict": {
      "enum": ["GREEN", "RED", "CONFIRM", "NO_COVERAGE", "INVALID_COVERAGE", "STALE"],
      "$comment": "Drawn from the closed vocabulary in pcb-agent/skills/_shared/coverage-gate.md. The export mints no new verdict."
    },
    "verdict_reasons": {"type": "array", "items": {"type": "string"}},
    "upload_authorized": {"type": "boolean"},
    "verdict_scope": {"type": "string"}
  },
  "$defs": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "scanned", "excluded", "violations"],
      "properties": {
        "eligible": {"type": "integer", "minimum": 0},
        "scanned": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0},
        "violations": {"type": "integer", "minimum": 0}
      }
    }
  }
}
